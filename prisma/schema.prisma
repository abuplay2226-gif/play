datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// 1. القوائم المحددة (Enums)
// -------------------------------------------------------------

enum Role {
  ADMIN
  CASHIER
  STAFF
}

enum DeviceType {
  PS4
  PS5
  PC
  VIP_ROOM
}

enum DeviceStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum SessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum SlotType {
  SINGLE
  MULTI
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  WALLET
  DEBT
  MIXED
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  NO_SHOW
}

// Enums خاصة بنظام البطولات
enum TournamentType {
  LEAGUE     // دوري كامل أو مجموعات + تصفيات
  KNOCKOUT   // كأس خروج مغلوب مباشر
  SUPER_CUP  // سوبر (فريقين نهائي مباشر أو 4 فرق)
}

enum TournamentStatus {
  REGISTRATION // التسجيل مفتوح
  ONGOING      // جارية حالياً
  COMPLETED    // منتهية
  CANCELLED    // ملغية
}

enum MatchStage {
  GROUP
  ROUND_OF_16
  QUARTER_FINAL
  SEMI_FINAL
  THIRD_PLACE
  FINAL
}

enum MatchStatus {
  SCHEDULED
  LIVE
  COMPLETED
  WALKOVER
}

// -------------------------------------------------------------
// 2. إدارة المستخدمين والورديات والخزائن المالية
// -------------------------------------------------------------

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String?
  name          String
  role          Role           @default(CASHIER)
  createdAt     DateTime       @default(now())
  shifts        Shift[]
  notifications Notification[]
}

model CashDrawer {
  id           String                 @id @default(uuid())
  name         String
  balance      Float                  @default(0.0)
  shifts       Shift[]
  transactions FinancialTransaction[]
}

model Shift {
  id             String                 @id @default(uuid())
  userId         String
  cashDrawerId   String
  user           User                   @relation(fields: [userId], references: [id])
  cashDrawer     CashDrawer             @relation(fields: [cashDrawerId], references: [id])
  openingBalance Float
  closingBalance Float?
  actualCash     Float?
  status         ShiftStatus            @default(OPEN)
  openedAt       DateTime               @default(now())
  closedAt       DateTime?
  sessions       DeviceSession[]
  orders         Order[]
  transactions   FinancialTransaction[]
}

model FinancialTransaction {
  id               String      @id @default(uuid())
  cashDrawerId     String
  shiftId          String?
  cashDrawer       CashDrawer  @relation(fields: [cashDrawerId], references: [id])
  shift            Shift?      @relation(fields: [shiftId], references: [id])
  customerId       String?
  supplierId       String?
  counterpartyType String?
  counterpartyName String?
  type             String
  amount           Float
  description      String
  createdAt        DateTime    @default(now())
}

// -------------------------------------------------------------
// 3. إدارة الأجهزة وجلسات اللعب والعدادات
// -------------------------------------------------------------

model Device {
  id               String          @id @default(uuid())
  name             String
  type             DeviceType
  singleHourlyRate Float
  multiHourlyRate  Float
  status           DeviceStatus    @default(AVAILABLE)
  sessions         DeviceSession[]
  bookings         Booking[]
}

model DeviceSession {
  id             String        @id @default(uuid())
  deviceId       String
  shiftId        String
  customerId     String?
  device         Device        @relation(fields: [deviceId], references: [id])
  shift          Shift         @relation(fields: [shiftId], references: [id])
  customer       Customer?     @relation(fields: [customerId], references: [id])
  startTime      DateTime      @default(now())
  endTime        DateTime?
  status         SessionStatus @default(ACTIVE)
  timeCost       Float         @default(0.0)
  totalCost      Float         @default(0.0)
  isFixedTime    Boolean       @default(false)
  fixedDuration  Int?
  plannedMinutes Int?
  slots          TimeSlot[]
  orders         Order[]
}

model TimeSlot {
  id         String        @id @default(uuid())
  sessionId  String
  session    DeviceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type       SlotType      @default(SINGLE)
  hourlyRate Float
  startTime  DateTime      @default(now())
  endTime    DateTime?
  totalCost  Float         @default(0.0)
}

// -------------------------------------------------------------
// 4. المخزون، المنتجات، المواد الخام، وشجرة الوصفات (BOM)
// -------------------------------------------------------------

model Category {
  id       String    @id @default(uuid())
  name     String
  products Product[]
}

model Product {
  id              String         @id @default(uuid())
  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id])
  name            String
  barcode         String?        @unique
  sellPrice       Float
  costPrice       Float          @default(0.0)
  stockQuantity   Float          @default(0.0)
  minStockAlert   Float          @default(5.0)
  isRawMaterial   Boolean        @default(false)
  unit            String         @default("قطعة")
  orderItems      OrderItem[]
  purchaseItems   PurchaseItem[]
  recipeItems     RecipeItem[]   @relation("RecipeProduct")
  ingredientItems RecipeItem[]   @relation("RecipeIngredient")
}

model RecipeItem {
  id           String  @id @default(uuid())
  productId    String
  ingredientId String
  quantity     Float   @default(1.0)

  product    Product @relation("RecipeProduct", fields: [productId], references: [id], onDelete: Cascade)
  ingredient Product @relation("RecipeIngredient", fields: [ingredientId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// 5. نقاط البيع والطلبات (POS)
// -------------------------------------------------------------

model Order {
  id            String         @id @default(uuid())
  shiftId       String
  sessionId     String?
  shift         Shift          @relation(fields: [shiftId], references: [id])
  session       DeviceSession? @relation(fields: [sessionId], references: [id])
  items         OrderItem[]
  totalAmount   Float          @default(0.0)
  paymentMethod PaymentMethod?
  status        OrderStatus    @default(PENDING)
  createdAt     DateTime       @default(now())
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
  subTotal  Float
}

// -------------------------------------------------------------
// 6. الموردون وفواتير الشراء
// -------------------------------------------------------------

model Supplier {
  id        String            @id @default(uuid())
  name      String
  phone     String?
  balance   Float             @default(0.0)
  purchases PurchaseInvoice[]
}

model PurchaseInvoice {
  id          String         @id @default(uuid())
  supplierId  String
  supplier    Supplier       @relation(fields: [supplierId], references: [id])
  invoiceDate DateTime       @default(now())
  totalAmount Float
  paidAmount  Float          @default(0.0)
  items       PurchaseItem[]
}

model PurchaseItem {
  id        String          @id @default(uuid())
  invoiceId String
  productId String
  invoice   PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id])
  quantity  Float
  unitCost  Float
}

// -------------------------------------------------------------
// 7. إدارة العملاء والحجوزات والإشعارات
// -------------------------------------------------------------

model Customer {
  id                      String                  @id @default(uuid())
  name                    String
  phone                   String                  @unique
  loyaltyPts              Int                     @default(0)
  debt                    Float                   @default(0.0)
  sessions                DeviceSession[]
  bookings                Booking[]
  notifications           Notification[]
  tournamentParticipations TournamentParticipant[]
}

model Notification {
  id         String    @id @default(uuid())
  title      String
  message    String
  type       String    @default("INFO")
  customerId String?
  userId     String?
  bookingId  String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  customer Customer? @relation(fields: [customerId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])
  booking  Booking?  @relation(fields: [bookingId], references: [id])
}

model Booking {
  id            String         @id @default(uuid())
  deviceId      String
  customerId    String
  device        Device         @relation(fields: [deviceId], references: [id])
  customer      Customer       @relation(fields: [customerId], references: [id])
  startTime     DateTime
  endTime       DateTime
  status        BookingStatus  @default(PENDING)
  notes         String?
  notifications Notification[]
}

// -------------------------------------------------------------
// 8. العروض والباقات وتقييمات العملاء
// -------------------------------------------------------------

model ServiceOffer {
  id          String   @id @default(uuid())
  title       String
  description String
  price       String
  icon        String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model PackagePlan {
  id        String   @id @default(uuid())
  name      String
  price     Int
  feature   String
  highlight Boolean  @default(false)
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model CustomerReview {
  id        String   @id @default(uuid())
  name      String
  text      String
  rating    Int      @default(5)
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// -------------------------------------------------------------
// 9. نظام إدارة البطولات (Tournaments & eSports Engine)
// -------------------------------------------------------------

model Tournament {
  id                  String                  @id @default(uuid())
  title               String                  // اسم البطولة (مثلاً: دوري الأبطال FC 26)
  gameName            String                  // اسم اللعبة (FC 26, PES 21, Tekken...)
  type                TournamentType          // دوري LEAGUE، كأس KNOCKOUT، سوبر SUPER_CUP
  status              TournamentStatus        @default(REGISTRATION)
  entryFee            Float                   @default(0.0) // رسوم الاشتراك لكل لاعب
  prizePool           Float                   @default(0.0) // مجموع الجوائز المالية
  groupCount          Int                     @default(1)   // عدد المجموعات
  qualifiersPerGroup  Int                     @default(2)   // كم متأهل من كل مجموعة
  startDate           DateTime                @default(now())
  endDate             DateTime?
  groups              TournamentGroup[]
  participants        TournamentParticipant[]
  matches             TournamentMatch[]
  createdAt           DateTime                @default(now())
}

model TournamentGroup {
  id           String                  @id @default(uuid())
  tournamentId String
  tournament   Tournament              @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String                  // اسم المجموعة (المجموعة A، المجموعة B...)
  participants TournamentParticipant[]
  matches      TournamentMatch[]
}

model TournamentParticipant {
  id           String           @id @default(uuid())
  tournamentId String
  tournament   Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer         @relation(fields: [customerId], references: [id])
  groupId      String?
  group        TournamentGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  teamName     String?          // اسم الفريق المختار (مثلاً: ريال مدريد، السيتي...)

  // إحصائيات جدول الدوري الحية
  played       Int              @default(0) // لعب
  won          Int              @default(0) // فاز
  drawn        Int              @default(0) // تعادل
  lost         Int              @default(0) // خسر
  goalsFor     Int              @default(0) // له (أهداف مسجلة)
  goalsAgainst Int              @default(0) // عليه (أهداف مستقبلة)
  goalDiff     Int              @default(0) // فارق الأهداف
  points       Int              @default(0) // إجمالي النقاط (الفوز = 3، التعادل = 1)
  isQualified  Boolean          @default(false) // حالة الصعود للتصفيات (مع إمكانية التعديل اليدوي)

  matchesAsPlayer1 TournamentMatch[] @relation("Player1Matches")
  matchesAsPlayer2 TournamentMatch[] @relation("Player2Matches")
  matchesWon       TournamentMatch[] @relation("WonMatches")
  createdAt        DateTime          @default(now())
}

model TournamentMatch {
  id           String                  @id @default(uuid())
  tournamentId String
  tournament   Tournament              @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  groupId      String?
  group        TournamentGroup?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  stage        MatchStage              @default(GROUP)
  roundNumber  Int                     @default(1)
  matchNumber  Int                     @default(1)

  player1Id    String?
  player1      TournamentParticipant?  @relation("Player1Matches", fields: [player1Id], references: [id], onDelete: SetNull)
  player2Id    String?
  player2      TournamentParticipant?  @relation("Player2Matches", fields: [player2Id], references: [id], onDelete: SetNull)

  player1Score Int?
  player2Score Int?
  isCompleted  Boolean                 @default(false)
  status       MatchStatus             @default(SCHEDULED)
  
  winnerId     String?
  winner       TournamentParticipant?  @relation("WonMatches", fields: [winnerId], references: [id], onDelete: SetNull)

  deviceId     String?                 // جهاز البلايستيشن المخصص للمباراة
  createdAt    DateTime                @default(now())
}